<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[;; Agent-based commute mode choice model for the Island of Montreal.
;; NetLogo port of SocialInteractionGraph_MostEfficientVersion.ipynb (Mesa).
;; See PORTING_NOTES.md for the design choices and the Info tab for usage.

extensions [ gis csv table array ]

__includes [
  "tmc-data.nls"         ;; world, GIS layers, census, networks, workplaces
  "tmc-population.nls"   ;; agents, activation, density, social network
  "tmc-travel.nls"       ;; shortest-path travel times
  "tmc-choice.nls"       ;; standardisation, utilities, model step
  "tmc-calibration.nls"  ;; objective function, parameter search, betas I/O
  "tmc-relocation.nls"   ;; relocation experiment
]

globals [
  patch-m                ;; metres per patch
  env-minx env-miny      ;; MTM coordinates of the world's lower-left corner
  da-dataset             ;; DA polygons (for drawing)
  da-rows                ;; montreal_da: one table per DA row, census order
  node-table             ;; network nodeid -> node index (who)
  networks               ;; mode -> [forward backward] adjacency arrays
  max-edges              ;; largest edge count of the four networks
  lane-segs             ;; bike-lane segments [x1 y1 x2 y2] in NetLogo units
  wp-x wp-y              ;; workplace coordinates (MTM metres)
  path-caches            ;; network -> table (origin, destination) -> travel time
  agents-by-da           ;; DA_name -> list of adult persons
  std-stats              ;; variable -> [mean std]
  betas                  ;; 33 coefficients, or false
  social-interaction?    ;; false on the first step after a reset
  data-loaded?
  mode-names             ;; ["auto" "transit" "bike" "walk"]
  last-error             ;; last calibration objective
  ;; bidirectional Dijkstra state (tmc-travel.nls)
  dist-f dist-b seen-f seen-b done-f done-b
  heap-key-f heap-node-f heap-size-f heap-key-b heap-node-b heap-size-b
  query-id
]

breed [ nodes node ]               ;; network nodes (shared by the 4 networks)
breed [ stm-stops stm-stop ]
breed [ residences residence ]     ;; residential parcels (at their centroid)
breed [ workspots workspot ]       ;; one per employed person, at the workplace
breed [ persons person ]           ;; the agents (adults)

patches-own [ lane-ids ]           ;; indices of bike-lane segments crossing the patch
nodes-own [ node-id ]
stm-stops-own [ stop-node ]
residences-own [ res-id res-feature res-node x-m y-m res-diag ]
workspots-own [ owner ]

persons-own [
  age gender age-group da-id income
  home-res home-x home-y           ;; residential parcel and its centroid (MTM metres)
  work-x work-y work-spot          ;; workplace (MTM metres), false if none
  commute-distance pop-dens proximity-to-bikelane
  home-node work-node home-stm-node work-stm-node
  time-car time-walk time-home-stm time-stm-stm time-stm-work time-bike  ;; false = no path
  auto-available? walk-available? transit-available? bike-available?
  z-auto z-transit z-bike z-walk z-income z-age z-dens z-prx
  u-auto u-transit u-bike u-walk   ;; false = unavailable (-inf)
  peers peer-bike-share
  mode-choice
  relocated?
]

to setup
  setup-data
  setup-population
end

to-report workplaces-file
  report "derived/workplaces_xy.txt"
end
]]></code>
